@startuml 数据同步模块接口

' ==================== 枚举 ====================

enum EngineType {
  MO_MO_BEI
  ANKI
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR
}

' ==================== 数据模型 ====================

class MemEntry {
  ' 条目唯一标识（引擎内唯一）
  + id: String
  ' 词汇 / 短语原文
  + word: String
  ' 释义
  + meaning: String
  ' 来源引擎
  + source: EngineType
  ' 标签（词性 / 分类）
  + tags: List<String>

  ' ——— SRS 参数 ———
  ' 记忆等级（0=新词）
  + level: Int
  ' 易度因子（SM-2 EF）
  + easeFactor: Float
  ' 当前复习间隔（秒）
  + interval: Int64
  ' 连续正确次数
  + consecutiveCorrect: Int
  ' 总复习次数
  + totalReviews: Int
  ' 下次复习时间戳
  + nextReviewAt: Int64
  ' 最后复习时间戳
  + lastReviewedAt: Int64
}

note right of MemEntry
  MemEntry 是 app 内部统一的记忆条目表示。
  无论底层是默默背单词还是 Anki，都映射为此结构。
end note

class SRSConfig {
  + engineType: EngineType
  ' 引擎专属配置（JSON，如路径 / token）
  + options: String
  ' 自动同步间隔（秒），0 表示不自动同步
  + autoSyncInterval: Int
}

class SyncReport {
  + success: Bool
  + pulledCount: Int
  + pushedCount: Int
  + conflictCount: Int
  + errors: List<String>
  + syncedAt: Int64
}

' ==================== 接口定义 ====================

interface "IDataSync" {

  ' ——— 引擎生命周期 ———
  ' 连接到 SRS 引擎
  + connect(config: SRSConfig): Bool
  ' 断开连接
  + disconnect(): Void
  ' 是否已连接
  + isConnected(): Bool
  ' 获取当前引擎类型
  + engineType(): EngineType
  ' 引擎是否支持写入（默默背单词可能为只读）
  + isWritable(): Bool

  ' ——— 条目查询 ———
  ' 获取所有记忆条目（从本地缓存）
  + getAllEntries(): List<MemEntry>
  ' 获取到期需复习的条目，按 nextReviewAt 排序
  + getDueEntries(limit: Int): List<MemEntry>
  ' 根据 ID 查询单条
  + getEntryById(id: String): MemEntry | Null
  ' 搜索条目（关键词匹配 word / meaning）
  + searchEntries(keyword: String): List<MemEntry>

  ' ——— 条目更新 ———
  ' 复习后更新条目状态，quality 为 SM-2 评分 (0~5)
  + updateEntryAfterReview(id: String, quality: Int): Void
  ' 批量更新（用于离线累积后一次性提交）
  + batchUpdateEntries(updates: List<EntryUpdate>): Void
  ' 添加自定义词条（返回分配的 id）
  + addEntry(word: String, meaning: String, tags: List<String>): String
  ' 删除词条
  + removeEntry(id: String): Void

  ' ——— 双向同步 ———
  ' 从引擎拉取最新数据（增量）
  + pullFromEngine(): SyncReport
  ' 将本地变更推送到引擎
  + pushToEngine(): SyncReport
  ' 全量双向同步
  + fullSync(): SyncReport
  ' 获取上次同步结果
  + lastSyncReport(): SyncReport | Null
}

note right of IDataSync
  信号（Qt signal）:
  - connected()
  - disconnected(reason: String)
  - entriesChanged(updatedIds: List<String>)
  - syncFinished(report: SyncReport)
  - errorOccurred(error: String)
end note

' ==================== 补充结构 ====================

class EntryUpdate {
  + id: String
  + quality: Int
  + reviewedAt: Int64
}

note bottom of EntryUpdate
  用于 batchUpdateEntries 的批量更新单元。
  updateEntryAfterReview 的内部参数也与之相同。
end note

@enduml
